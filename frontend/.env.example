# =============================================================================
# AI Business Hub — frontend environment template
# Copy to .env.local and fill in real values. NEVER commit .env.local.
# =============================================================================
#
# Next.js rule: anything prefixed NEXT_PUBLIC_ is compiled INTO THE BROWSER
# BUNDLE and is readable by anyone. Everything without that prefix stays on the
# server. Read every line below with that in mind.

# ---------------------------------------------------------------- Supabase
# Browser-safe by design: row-level security is what protects the data behind
# the anon key, not the key itself.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------- app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# mock = serve data from src/lib/mock
# api  = call the FastAPI backend (what you want for real use)
NEXT_PUBLIC_DATA_MODE=api

# ------------------------------------------------------- public chat backend
# Browser-visible on purpose: the chat API is public and holds no secret.
NEXT_PUBLIC_CHAT_API_URL=http://127.0.0.1:8000

# ---------------------------------------------------------- owner dashboard
# SERVER ONLY. No NEXT_PUBLIC_ prefix, so these never reach the browser. The
# Next.js proxy at src/app/api/hub/[...path]/route.ts attaches the key
# server-side, which is the whole reason the dashboard key is not public.
HUB_API_BASE_URL=http://127.0.0.1:8000
# Must match DASHBOARD_API_KEY in backend/.env exactly.
HUB_DASHBOARD_KEY=

# The business the dashboard shows. Get it from Supabase:
#   select id from businesses where chat_slug = 'pulse-fitness';
NEXT_PUBLIC_LIVE_BUSINESS_ID=
